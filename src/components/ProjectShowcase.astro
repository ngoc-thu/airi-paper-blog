---
import LinkButton from "./LinkButton.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const projects = [
  {
    title: t.home.portfolioTitle,
    category: t.home.portfolioCategory,
    description: t.home.portfolioDescription,
    sourceUrl: "https://github.com/NgocTien0110/Portfolio",
    demoUrl: undefined,
  },
  {
    title: t.home.toolhubTitle,
    category: t.home.toolhubCategory,
    description: t.home.toolhubDescription,
    sourceUrl: "https://github.com/ngoc-thu/basic-tools-web",
    demoUrl: "https://toolhub-working-tools-self.vercel.app/",
  },
];
---

<section id="projects" class="pt-12 pb-6">
  <h2 class="text-2xl font-semibold tracking-wide">{t.home.projects}</h2>
  <p class="text-muted-foreground mt-3 max-w-3xl text-lg">
    {t.home.projectsIntro}
  </p>

  <div class="mt-6 grid gap-5 md:grid-cols-2">
    {
      projects.map(project => (
        <article class="glass-panel rounded-2xl p-6">
          <p class="text-accent text-sm font-semibold tracking-[0.18em] uppercase">
            {project.category}
          </p>
          <h3 class="mt-3 text-2xl font-semibold">{project.title}</h3>
          <p class="text-muted-foreground mt-3 text-lg">{project.description}</p>

          <div class="mt-5 flex flex-wrap gap-4 text-sm font-semibold uppercase tracking-wide">
            <LinkButton
              href={project.sourceUrl}
              target="_blank"
              rel="noreferrer"
              class="border-border bg-background/60 hover:border-accent rounded-lg border px-4 py-2"
            >
              {t.home.projectSource}
            </LinkButton>
            {
              project.demoUrl && (
                <LinkButton
                  href={project.demoUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="border-border bg-background/60 hover:border-accent rounded-lg border px-4 py-2"
                >
                  {t.home.projectDemo}
                </LinkButton>
              )
            }
          </div>
        </article>
      ))
    }
  </div>
</section>
